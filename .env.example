# Copy this file to .env and fill it in. The hub needs the same WORKER_TOKEN (EVENTS_WORKER_TOKEN in its .env).
WORKER_PORT=8900
# Best: this Pi's Tailscale address (run: tailscale ip -4), so only your Tailscale network can reach it.
WORKER_HOST=0.0.0.0
# A long random string, e.g. the output of:  openssl rand -hex 24
WORKER_TOKEN=change-me-to-a-long-random-string
# How many scrapers run at the same time inside one crawler file. Your laptop ran all of them at once; a Pi 4 with 2GB is
# happiest with 2. If crawls fail with memory errors, lower it to 1 (slower, but safest).
WORKER_CONCURRENCY=2
# A scraper that has not finished after this long is stopped and reported as timed out
WORKER_SCRAPER_TIMEOUT_MIN=8
WORKER_JOB_TIMEOUT_MIN=90
# Wait (up to a minute) before starting another scraper if less than this much memory is free
WORKER_MIN_FREE_MB=250
# Your crawlers launch a visible browser (headless: false). The service runs under xvfb so that works on a Pi.
WORKER_HEADLESS=false
