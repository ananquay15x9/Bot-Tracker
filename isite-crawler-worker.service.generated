[Unit]
Description=iSite crawler worker (runs the venue event crawlers for the hub)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=isite-crawler
WorkingDirectory=/home/isite-crawler/isite-crawler-worker
# xvfb-run gives the crawlers a virtual screen, because they open a visible (headed) browser
ExecStart=/usr/bin/xvfb-run -a --server-args="-screen 0 1280x1024x24" /usr/bin/node server.js
RequiresMountsFor=/mnt/events
Environment=TMPDIR=/mnt/events/tmp
Restart=always
RestartSec=5
# a crawl that eats all the memory is stopped by the system before it can take the whole Pi down
MemoryHigh=1500M
MemoryMax=1700M

[Install]
WantedBy=multi-user.target
